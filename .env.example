# Pandsy generator — environment template. Copy to generator/.env and fill in.
# This repo ships NO real values. Everything below is a placeholder.

# --- Generator service ---
PORT=3000
API_SECRET=your-generator-api-secret            # shared secret protecting the HTTP API
SITES_DIR=/home/USER/automation/sites            # where built sites are staged
CLAUDE_BIN=/path/to/claude                        # optional: Claude CLI path

# --- Email (outreach + contact forms) ---
RESEND_API_KEY=YOUR_RESEND_API_KEY
TEST_EMAIL=your-email@example.com

# --- Vercel (per-site deployment) ---
VERCEL_TEAM_ID=YOUR_VERCEL_TEAM_ID
VERCEL_AUTH_FILE=/home/USER/.local/share/com.vercel.cli/auth.json   # CLI token cache

# --- Google (lead database + scraping) ---
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_API_KEY

# --- Alerts (optional) ---
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
